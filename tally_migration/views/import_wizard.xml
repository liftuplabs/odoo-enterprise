<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_sales_import_wizard_form" model="ir.ui.view">
        <field name="name">tally.sales.import.wizard.form</field>
        <field name="model">tally.sales.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Tally Data">
                <group>
                    <field name="import_type"/>
                    <field name="excel_file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tally_sales_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Tally Data</field>
        <field name="res_model">tally.sales.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_tally_sales_import"
              name="Import Tally Data"
              parent="account.account_account_menu"
              action="action_tally_sales_import_wizard"
              sequence="10"/>
</odoo>