<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_partial_payment_wizard_form" model="ir.ui.view">
        <field name="name">multi.partial.payment.wizard.form</field>
        <field name="model">multi.partial.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Multiple Partial Payments">
                <group>
                    <group>
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="payment_date"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="1">
                        <field name="move_id" force_save="1"/>
                        <field name="partner_id"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount_residual" force_save="1"/>
                        <field name="amount_to_pay"/>
                    </list>
                </field>
                <footer>
                    <button string="Create Payments" name="action_create_payments" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_multi_partial_payment" model="ir.actions.act_window">
        <field name="name">Register Payments</field>
        <field name="res_model">multi.partial.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>