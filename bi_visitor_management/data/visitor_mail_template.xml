<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="email_template_visitor_pass" model="mail.template">
            <field name="name">Mail: Visitor Pass</field>
            <field name="model_id" ref="bi_visitor_management.model_visitor_visitor"/>
            <field name="subject">Visitor Pass</field>
            <field name="email_from">"{{ object.env.user.company_id.name }}" &lt;{{ (object.env.user.company_id.email or user.email) }}&gt;</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 13px; margin: 0px; padding: 0px;">
                                Hello,<br/>
                            <br/>
                                Thank you for your interest.
                                We wanted to let you know that, your Visiting Pass given below.
                            <br/>
                                Thank you,
                            <div style="font-size: 11px; color: grey;">
                                <t t-if="object.env.user">
                                        --                                    <br/>
                                    <strong t-out="object.env.user.name or ''">Mitchell Admin</strong>
                                    <br/>
                                        Email: <t t-out="object.env.user.email or ''">admin@yourcompany.example.com</t>
                                    <br/>
                                        Phone: <t t-out="object.env.user.phone or ''">+1 650-123-4567</t>
                                </t>
                                <t t-else="">
                                        --                                    <br/>
                                    <t>YourCompany</t>

                                </t>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </field>
        <field name="report_template_ids" eval="[(4, ref('bi_visitor_management.action_report_visitor_pass'))]"/>
    </record>
</data>
</odoo>