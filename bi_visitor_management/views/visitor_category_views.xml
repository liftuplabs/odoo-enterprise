<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="visitor_category_action" model="ir.actions.act_window">
        <field name="name">Visitor Category</field>
        <field name="res_model">visitor.category</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem name="Visitor Management" id="visitor_menu_action" web_icon="bi_visitor_management,static/description/icon.png" sequence="1">
        <menuitem id="configuration_menu" name="Configuration" sequence="20" groups="bi_visitor_management.group_visitor_manager">
            <menuitem id="visitor_category_menu" name="Visitor Category" action="visitor_category_action" sequence="10"/>
        </menuitem>
    </menuitem>

    <record id="visitor_category_view_form" model="ir.ui.view">
        <field name="name">visitor.category.form</field>
        <field name="model">visitor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="visitor_category_view_tree" model="ir.ui.view">
        <field name="name">visitor.category.list</field>
        <field name="model">visitor.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>