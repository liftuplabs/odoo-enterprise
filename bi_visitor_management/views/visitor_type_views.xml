<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="visitor_type_action" model="ir.actions.act_window">
        <field name="name">Visitor Type</field>
        <field name="res_model">visitor.type</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="visitor_type_menu" name="Visitor Type" action="visitor_type_action" parent="bi_visitor_management.configuration_menu" sequence="20"/>

    <record id="visitor_type_view_form" model="ir.ui.view">
        <field name="name">visitor.type.form</field>
        <field name="model">visitor.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="visitor_type_view_tree" model="ir.ui.view">
        <field name="name">visitor.type.list</field>
        <field name="model">visitor.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>