<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_visitor_visitor" model="ir.module.category">
            <field name="name">Visitor</field>
            <field name="description">Visitor Access Right</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_visitor_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_visitor_visitor"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.group_user'))]"/>

        </record>

        <record id="group_visitor_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_visitor_visitor"/>
            <field name="implied_ids" eval="[(4,ref('bi_visitor_management.group_visitor_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>