<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_hsn_history" model="ir.ui.view">
        <field name="name">product.template.form.inherit.hsn.history</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="HSN &amp; Taxes History" name="hsn_tax_history">
                    <field name="hsn_history_ids">
                        <list editable="top">
                            <field name="date"/>
                            <field name="product_id" column_invisible="1"/>
                            <field name="hsn_code"/>
                            <field name="sales_taxes_id" widget="many2many_tags"/>
                            <field name="purchase_taxes_id" widget="many2many_tags"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>