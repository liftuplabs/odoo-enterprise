<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="tis_material_requisition">
            <field name="name">Material Requisition</field>
            <field name="sequence">8</field>
        </record>

        <record id="materials_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="tis_material_requisition"/>
        </record>

        <record id="materials_group_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="implied_ids" eval="[(4, ref('materials_group_user'))]"/>
            <field name="category_id" ref="tis_material_requisition"/>
        </record>

        <record id="materials_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="tis_material_requisition"/>
            <field name="implied_ids" eval="[(4, ref('materials_group_officer'))]"/>
<!--            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>-->
        </record>
    </data>

</odoo>