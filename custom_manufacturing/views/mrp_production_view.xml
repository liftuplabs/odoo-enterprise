<odoo>
    <data>
        <record id="view_mrp_order_form_inherit" model="ir.ui.view">
            <field name="name">mrp.order.form.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="before">
                    <field name="production_order_id" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="machine_id" widget="many2one"/>
                </xpath>
                <xpath expr="//button[@name='button_unbuild']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="mrp_production_workorder_tree_editable_view" model="ir.ui.view">
            <field name="name">mrp.production.work.order.list.editable</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='duration']" position="after">
                    <field name="downtime_duration_display"/>
                    <field name="reason_id" widget="many2many_tags"/>
                    <field name="efficiency"/>
                    <field name="downtime_include" widget="boolean_toggle"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="operator"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>