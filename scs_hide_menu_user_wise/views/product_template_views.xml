<odoo>
    <record id="product_template_form_view_hide_prices" model="ir.ui.view">
        <field name="name">product.template.form.hide.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="groups">!scs_hide_menu_user_wise.group_hide_sale_price</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="groups">!scs_hide_menu_user_wise.group_hide_cost_price</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide in Product List (Tree) View -->
    <record id="product_template_tree_view_hide_prices" model="ir.ui.view">
        <field name="name">product.template.tree.hide.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="groups">!scs_hide_menu_user_wise.group_hide_sale_price</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="groups">!scs_hide_menu_user_wise.group_hide_cost_price</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide in Product Kanban View -->
    <record id="product_template_kanban_view_hide_prices" model="ir.ui.view">
        <field name="name">product.template.kanban.hide.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="groups">!scs_hide_menu_user_wise.group_hide_sale_price</attribute>
            </xpath>
        </field>
    </record>
</odoo>