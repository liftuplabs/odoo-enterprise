<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Rule to restrict menu visibility for specific users -->
    <record id="ir_ui_menu_rule_user" model="ir.rule">
        <field name="name">Restrict Menu Access for Users</field>
        <field name="model_id" ref="model_ir_ui_menu" />
        <field name="domain_force">[('restrict_user_ids', 'not in', user.id)]</field>
    </record>

    <record id="group_hide_sale_price" model="res.groups">
        <field name="name">Hide sale price in product</field>
        <field name="category_id" ref="base.module_category_usability"/>
    </record>

    <record id="group_hide_cost_price" model="res.groups">
        <field name="name">Hide cost price in product</field>
        <field name="category_id" ref="base.module_category_usability"/>
    </record>
</odoo>
