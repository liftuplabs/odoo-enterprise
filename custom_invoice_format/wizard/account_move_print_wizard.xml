    <record id="view_account_move_print_wizard_form" model="ir.ui.view">
        <field name="name">account.move.print.wizard.form</field>
        <field name="model">account.move.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Print Copy">
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="copy_type" widget="radio"/>
                </group>
                <footer>
                    <button string="Print Report" type="object" name="action_print" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>