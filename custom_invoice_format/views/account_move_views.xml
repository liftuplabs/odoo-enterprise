<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_custom_invoice" model="ir.ui.view">
        <field name="name">account.move.form.custom.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_print_wizard" type="object" string="Print Tax Invoice" class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Print Layout Settings" name="print_layout_settings">
                    <group>
                        <group string="Typography &amp; Spacing">
                            <field name="custom_layout_size" widget="radio" options="{'horizontal': true}"/>
                            <field name="custom_font_size"/>
                        </group>

                        <group string="Table Configurations">
                            <field name="custom_table_style"/>
                            <field name="custom_bold_table_data"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//notebook" position="inside">
                 <page string="Transport &amp; Delivery" name="custom_transport_info" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Delivery Details">
                            <field name="dispatch_doc_no"/>
                            <field name="dispatch_through"/>
                            <field name="destination"/>
                            <field name="delivery_note"/>
                            <field name="delivery_note_date"/>
                        </group>
                        <group string="References">
                            <field name="supplier_reference"/>
                            <field name="other_reference"/>
                            <field name="buyers_order_no"/>
                            <field name="buyers_order_date"/>
                             <field name="mode_of_payment" invisible="1"/>
                        </group>
                    </group>
                    <group string="Terms">
                         <field name="terms_of_delivery"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_inherit_sale_info" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.sale.info</field>
        <field name="model">account.move</field>
        <!-- Inheriting the specific tree view for Customer Invoices -->
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">

            <!-- Insert the new columns after the Invoice Date -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="sale_order_name" optional="show"/>
                <field name="sale_order_date" optional="show" widget="date"/>
            </xpath>

        </field>
    </record>

    <record id="view_move_form_custom_eway" model="ir.ui.view">
        <field name="name">account.move.form.custom.eway</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_in_edi_ewaybill.invoice_form_inherit_l10n_in_edi_ewaybill"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="transaction_type" readonly="edi_state in ('sent', 'successful') or eway_bill_no"/>
                <field name="edi_state" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='l10n_in_edi_ewaybill_page']/group[@name='ewaybill_group']" position="before">
                <group name="ewaybill_info_group" string="E-Way Bill Info">
                    <group>
                        <field name="eway_bill_no" invisible="not eway_bill_no"/>
                        <field name="eway_bill_date" invisible="not eway_bill_date"/>
                        <field name="eway_bill_valid_till" invisible="not eway_bill_valid_till"/>
                        <button name="action_compute_eway_bill_info" type="object" string="Fetch Ewb info" class="btn btn-link"/>
                        <button name="action_update_eway_bill_json" invisible='not eway_bill_no' type="object" string="Update Ewb info" class="btn btn-link"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
