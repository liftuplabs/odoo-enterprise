<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_custom_invoice" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.custom.invoice</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='invoicing_settings']" position="after">
                    <block title="Custom Invoice Layout" id="custom_invoice_layout_settings">
                        <setting id="custom_invoice_general" help="Customize the look of your Tax Invoice PDF.">
                            <field name="invoice_layout_boxed"/>
                            <div class="content-group" invisible="not invoice_layout_boxed">
                                <div class="row mt16">
                                    <label for="custom_invoice_title" class="col-lg-3 o_light_label"/>
                                    <field name="custom_invoice_title"/>
                                </div>
                                <div class="row mt16">
                                    <label for="custom_invoice_font_family" class="col-lg-3 o_light_label"/>
                                    <field name="custom_invoice_font_family"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="custom_invoice_colors" help="Set colors and border styles." invisible="not invoice_layout_boxed">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="custom_invoice_header_bg_color" class="col-lg-3 o_light_label"/>
                                    <field name="custom_invoice_header_bg_color" widget="color"/>
                                </div>
                                <div class="row mt16">
                                    <label for="custom_invoice_header_text_color" class="col-lg-3 o_light_label"/>
                                    <field name="custom_invoice_header_text_color" widget="color"/>
                                </div>
                                <div class="row mt16">
                                    <label for="custom_invoice_border_color" class="col-lg-3 o_light_label"/>
                                    <field name="custom_invoice_border_color" widget="color"/>
                                </div>
                                <div class="row mt16">
                                    <label for="custom_invoice_border_thickness" class="col-lg-3 o_light_label"/>
                                    <field name="custom_invoice_border_thickness"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
