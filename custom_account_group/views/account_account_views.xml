<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.view.form.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='group_id']" position="before">
                    <field name="parent_group_id"/>
                </xpath>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_list">
        <field name="name">account.account.list (in account_reconcile_oca)</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="debit"/>
                <field name="credit"/>
                <field name="acc_current_balance"/>
            </xpath>
        </field>
    </record>
</odoo>