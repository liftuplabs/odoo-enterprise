<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Ensure the hidden security group exists (if you already added this for Sales, you don't need to duplicate the group record itself, but you do need the record below it) -->
    <record id="group_hide_standard_reports" model="res.groups">
        <field name="name">Hidden Reports Group</field>
        <field name="comment">Assign standard core reports to this group to hide them from the Print menu.</field>
    </record>

    <!-- 2. Restrict the standard Purchase Order report to ONLY the hidden group -->
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="groups_id" eval="[(6, 0, [ref('group_hide_standard_reports')])]"/>
    </record>

    <!-- 3. Purchase Order Wizard Form View -->
    <record id="view_purchase_order_print_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.print.wizard.form</field>
        <field name="model">purchase.order.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Print Copy">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="copy_type" widget="radio"/>
                </group>
                <footer>
                    <button string="Download PDF" type="object" name="action_print" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 4. Bind the Custom Wizard to the "Print" / "Download" Menu -->
    <record id="action_purchase_order_print_wizard" model="ir.actions.act_window">
        <!-- The name here is exactly what will show up in the dropdown menu -->
        <field name="name">Purchase Order / RFQ</field>
        <field name="res_model">purchase.order.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">form,list</field>
    </record>

</odoo>