<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="repair.report_repairorder">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)" />

            <!-- Check context for the selected print type -->
            <t t-set="requested_copy" t-value="o.env.context.get('custom_print_copy', 'Original')"/>
            <t t-set="copies_to_print" t-value="['Original', 'Duplicate', 'Triplicate'] if requested_copy == 'All' else [requested_copy]"/>

            <!-- Loop over the selected copies -->
            <t t-foreach="copies_to_print" t-as="copy_name">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 13px; color: #000; padding-top: 20px;">

                    <!-- Internal CSS -->
                    <style>
                        .report-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 20px;
                        }
                        .report-table th, .report-table td {
                            border: 1px solid #000000 !important;
                            padding: 6px;
                            vertical-align: middle;
                        }
                        .report-table th {
                            background-color: #f2f2f2 !important;
                            font-weight: bold;
                            text-align: center;
                            text-transform: uppercase;
                        }
                        .report-table td {
                            text-align: center;
                        }
                        .report-table .text-start {
                            text-align: left;
                        }
                        .section-title {
                            font-weight: bold;
                            margin-bottom: 5px;
                            text-transform: uppercase;
                            font-size: 14px;
                        }
                    </style>

                    <!-- Dynamic Label (Original, Duplicate, etc.) -->
                    <div class="row">
                        <div class="col-12 text-end" style="min-height: 24px;">
                            <t t-if="copy_name and copy_name != 'Not Applicable'">
                                <em>(<span t-esc="copy_name"/>)</em>
                            </t>
                        </div>
                    </div>

                    <!-- Top Document Header with Bottom Line Only and Right-Aligned Logo -->
                    <div class="row align-items-center mb-4" style="border-bottom: 2px solid #000; padding-bottom: 15px; margin: 0;">
                        <div class="col-5">
                            <strong>INDIA Repair NR: </strong> <span t-field="o.name" /><br/>
                            <strong>Customer PO: </strong> <span t-field="o.customer_po" />
                        </div>
                        <div class="col-4 text-end">
                            <strong>2M: </strong> <span t-field="o.name" /><br/>
                            <strong>2R: </strong> <span t-field="o.name" />
                        </div>
                        <div class="col-3 text-end">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 70px; max-width: 100%;" alt="Company Logo"/>
                        </div>
                    </div>

                    <!-- 1. Customer Info Table -->
                    <div class="section-title">Customer Info</div>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Customer Number</th>
                                <th>Customer Name</th>
                                <th>Info</th>
                                <th>Incoming Date</th>
                                <th>Shipment Carrier</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span t-field="o.partner_id.ref" /></td>
                                <td class="text-start"><span t-field="o.partner_id.name" /></td>
                                <td><span t-field="o.partner_id.comment" /></td>
                                <td><span t-field="o.inward_date" /></td>
                                <td><span t-field="o.shipment_carrier" /></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 2. Unit Info Table -->
                    <div class="section-title">Unit Info</div>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Part Number</th>
                                <th>Unit Type</th>
                                <th>Serial Number</th>
                                <th>Production Date</th>
                                <th>Modul</th>
                                <th>SW on Label</th>
                                <th>Unit Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span t-field="o.product_id.default_code" /></td>
                                <td><span t-field="o.unit" /></td>
                                <td><span t-field="o.lot_id.name" /></td>
                                <td><span t-field="o.inward_date" /></td>
                                <td><span t-field="o.module" /></td>
                                <td><span t-field="o.sw_on_label" /></td>
                                <td><span t-field="o.unit_status_us" /></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 3. Error Info Table -->
                    <div class="section-title">Error Info</div>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 20%;">Incoming Software</th>
                                <th style="width: 20%;">Failure Date</th>
                                <th style="width: 20%;">Customer Error</th>
                                <th style="width: 40%;">Failure Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span t-field="o.incoming_software" /></td>
                                <td><span t-field="o.failure_date" /></td>
                                <td><span t-field="o.customer_error" /></td>
                                <td class="text-start"><span t-field="o.failure_description" /></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 4. OLD Parts Table -->
                    <div class="section-title">OLD Parts</div>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Part Number</th>
                                <th style="width: 35%;">Description</th>
                                <th style="width: 20%;">Info</th>
                                <th style="width: 20%;">Info_</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.old_part_ids" t-as="line">
                                <td><span t-field="line.product_id.default_code" /></td>
                                <td class="text-start"><span t-field="line.fi_part_old" /></td>
                                <td><span t-field="line.warranty_validity" /></td>
                                <td><span t-field="line.tag_ids" /></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 5. NEW Parts Table -->
                    <div class="section-title">NEW Parts</div>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Part Number</th>
                                <th style="width: 35%;">Description</th>
                                <th style="width: 20%;">Info</th>
                                <th style="width: 20%;">Info_</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.move_ids.filtered(lambda l: l.repair_line_type == 'add')" t-as="line">
                                <td><span t-field="line.product_id.default_code" /></td>
                                <td class="text-start"><span t-field="line.product_id.name" /></td>
                                <td><span t-field="line.name" /></td>
                                <td><span t-field="line.product_id.categ_id.name" /></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Checklists and Final Details -->
                    <div class="row mb-4 mt-4">
                        <div class="col-6">
                            <table class="table table-sm table-borderless">
                                <tr t-foreach="o.check_list_ids" t-as="check">
                                    <!-- Larger Checkbox and larger tick mark -->
                                    <td style="width: 40px; vertical-align: middle; padding: 4px;">
                                        <div style="width: 24px; height: 24px; border: 2px solid #000; text-align: center; line-height: 24px; font-size: 24px; font-weight: bold;">
                                            <t t-if="check.is_check">✓</t>
                                        </div>
                                    </td>
                                    <!-- Larger font size for the checkbox text -->
                                    <td style="padding: 4px; vertical-align: middle; font-size: 15px;"><span t-field="check.question_id.name" /></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6">
                            <div class="section-title" style="margin-bottom: 2px; font-size: 13px;">Error Description</div>
                            <div class="fw-bold" style="text-transform: uppercase; margin-bottom: 5px;">Possible Reason</div>

                            <div style="border: 1px solid #000; min-height: 100px; padding: 10px; background-color: #fff;">
                                <span t-field="o.failure_description" />
                            </div>
                        </div>
                    </div>

                    <!-- Footer Summary Strip -->
                    <div class="row" style="border: 1px solid #000; padding: 12px; margin: 0;">
                        <div class="col-2"><strong>Repair Time:</strong><br/><span t-field="o.duration" /></div>
                        <div class="col-3"><strong>Technician:</strong><br/><span t-field="o.user_id" /></div>
                        <div class="col-3"><strong>Outgoing SW:</strong><br/><span t-field="o.sw_on_label" /></div>
                        <div class="col-2"><strong>Account:</strong><br/><span t-field="o.account_en" /></div>
                        <div class="col-2"><strong>Return Date:</strong><br/><span t-field="o.return_date" /></div>
                    </div>

                    <div class="row mt-5 mb-5">
                        <div class="col-12 text-end">
                             <strong>Sign:</strong> _________________________
                        </div>
                    </div>

                    <!-- Force a page break between copies if iterating over 'All' -->
                    <p style="page-break-after: always;" t-if="not copy_name_last"/>

                </div>
            </t>
        </t>
    </template>
</odoo>