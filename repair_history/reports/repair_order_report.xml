<template id="repair.report_repairorder">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)" />
        <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">

            <div class="row" style="border: 1px solid #000; padding: 10px; margin-bottom: 10px;">
                <div class="col-6">
                    <strong>INDIA Repair NR: </strong> <span t-field="o.name" /><br/>
                    <strong>Customer PO: </strong> <span t-field="o.customer_po" />
                </div>
                <div class="col-6 text-right">
                    <strong>2M: </strong> <span t-field="o.name" /><br/> <strong>2R: </strong> <span t-field="o.name" /> </div>
            </div>

            <h5 style="background-color: #f2f2f2; padding: 5px; border: 1px solid #000; margin: 0;">Customer Info</h5>
            <table class="table table-bordered table-sm" style="margin-bottom: 20px;">
                <tr>
                    <th>Customer Number</th>
                    <th>Customer Name</th>
                    <th>Info</th>
                    <th>Incoming Date</th>
                    <th>Shipment Carrier</th>
                </tr>
                <tr>
                    <td><span t-field="o.partner_id.ref" /></td>
                    <td><span t-field="o.partner_id.name" /></td>
                    <td><span t-field="o.partner_id.comment" /></td>
                    <td><span t-field="o.inward_date" /></td>
                    <td><span t-field="o.shipment_carrier" /></td>
                </tr>
            </table>

            <h5 style="background-color: #f2f2f2; padding: 5px; border: 1px solid #000; margin: 0;">Unit Info</h5>
            <table class="table table-bordered table-sm" style="margin-bottom: 20px;">
                <tr>
                    <th>Part Number</th>
                    <th>Unit Type</th>
                    <th>Serial Number</th>
                    <th>Production Date</th>
                    <th>Modul</th>
                    <th>SW_on_Label</th>
                    <th>Unit Status</th>
                </tr>
                <tr>
                    <td><span t-field="o.product_id.default_code" /></td>
                    <td><span t-field="o.unit" /></td>
                    <td><span t-field="o.lot_id.name" /></td>
                    <td><span t-field="o.inward_date" /></td> <td><span t-field="o.module" /></td>
                    <td><span t-field="o.sw_on_label" /></td>
                    <td><span t-field="o.unit_status_us" /></td>
                </tr>
            </table>

            <h5 style="background-color: #f2f2f2; padding: 5px; border: 1px solid #000; margin: 0;">Error Info</h5>
            <div style="border: 1px solid #000; padding: 10px; margin-bottom: 20px;">
                <div class="row">
                    <div class="col-4"><strong>Incoming Software:</strong> <span t-field="o.incoming_software" /></div>
                    <div class="col-4"><strong>Failure Date:</strong> <span t-field="o.failure_date" /></div>
                    <div class="col-4"><strong>Customer Error:</strong> <span t-field="o.customer_error" /></div>
                </div>
                <div class="row mt-2">
                    <div class="col-12"><strong>Failure Description:</strong> <br/><span t-field="o.failure_description" /></div>
                </div>
            </div>

            <h5 style="background-color: #f2f2f2; padding: 5px; border: 1px solid #000; margin: 0;">OLD Parts</h5>
            <table class="table table-bordered table-sm" style="margin-bottom: 20px;">
                <thead>
                    <tr>
                        <th>Part Number</th>
                        <th>Description</th>
                        <th>Info</th>
                        <th>Info_</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.old_part_ids" t-as="line">
                        <td><span t-field="line.product_id.default_code" /></td>
                        <td><span t-field="line.fi_part_old" /></td>
                        <td><span t-field="line.warranty_validity" /></td>
                        <td><span t-field="line.tag_ids" /></td>
                    </tr>
                </tbody>
            </table>

            <h5 style="background-color: #f2f2f2; padding: 5px; border: 1px solid #000; margin: 0;">NEW Parts</h5>
            <table class="table table-bordered table-sm" style="margin-bottom: 20px;">
                <thead>
                    <tr>
                        <th>Part Number</th>
                        <th>Description</th>
                        <th>Info</th>
                        <th>Info_</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.move_ids.filtered(lambda l: l.repair_line_type == 'add')" t-as="line">
                        <td><span t-field="line.product_id.default_code" /></td>
                        <td><span t-field="line.product_id.name" /></td>
                        <td><span t-field="line.name" /></td>
                        <td><span t-field="line.product_id.categ_id.name" /></td>
                    </tr>
                </tbody>
            </table>

            <div class="row" style="margin-bottom: 20px;">
                <div class="col-6">
                    <table style="width: 100%;">
                        <tr t-foreach="o.check_list_ids" t-as="check">
                            <td style="width: 20px;">
                                <t t-if="check.is_check">☑</t><t t-else="">☐</t>
                            </td>
                            <td><span t-field="check.question_id.name" /></td>
                        </tr>
                    </table>
                </div>
                <div class="col-6">
                    <strong>Possible Reason:</strong><br/>
                    <div style="border: 1px solid #000; height: 100px; padding: 5px;">
                        <span t-field="o.failure_description" />
                    </div>
                </div>
            </div>

            <div class="row" style="border: 1px solid #000; padding: 10px;">
                <div class="col-3"><strong>Repair Time:</strong> <span t-field="o.duration" /></div>
                <div class="col-3"><strong>Technician:</strong> <span t-field="o.user_id" /></div>
                <div class="col-3"><strong>Outgoing Software:</strong> <span t-field="o.sw_on_label" /></div>
                <div class="col-3"><strong>Account:</strong> <span t-field="o.account_en" /></div>
            </div>

            <div style="margin-top: 30px;">
                 <strong>Sign:</strong> _______________
            </div>

        </div>
    </t>
</template>