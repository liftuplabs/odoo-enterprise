                        <!-- Footer / Signature -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <strong>Company's PAN: </strong>
                                <span t-field="o.company_id.l10n_in_pan"/><br/><br/>
                            </div>
                        </div>
                        <div class="row mt-5">
                            <div class="col-6 text-end">
                                <strong>For <span t-field="o.company_id.name"/></strong>
                                <br/><br/>
                                <t t-if="o.company_id.digital_signature">
                                    <img t-att-src="image_data_uri(o.company_id.digital_signature)" style="max-height: 80px;"/>
                                </t>
                                <br/><br/>
                                <strong>Authorized Signatory</strong>
                            </div>
                        </div>

                    </div>
                    <div class="footer" t-attf-style="font-family: {{font_family}}, sans-serif;">
                        <div class="text-center" style="padding-top: 5px; width: 100%;">
                            <span style="font-size: 13px; font-weight: 500; color: #444444; letter-spacing: 0.5px;">
                                This is a Computer Generated Document
                            </span>
                        </div>
                    </div>
                </t>
            </xpath>


