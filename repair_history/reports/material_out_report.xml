<odoo>
    <template id="report_deliveryslip_custom" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)" />

                    <t t-set="border_color" t-value="o.company_id.custom_invoice_border_color or '#000000'"/>
                    <t t-set="border_width" t-value="o.company_id.custom_invoice_border_thickness or 1"/>
                    <t t-set="header_bg" t-value="o.company_id.custom_invoice_header_bg_color or '#f0f0f0'"/>
                    <t t-set="header_text" t-value="o.company_id.custom_invoice_header_text_color or '#000000'"/>
                    <t t-set="font_family" t-value="o.company_id.custom_invoice_font_family or 'Arial'"/>

                    <div class="page" t-attf-style="font-family: {{font_family}}, sans-serif; font-size: 13px; line-height: 1.1; padding-top: 0px; margin-top: 0px;">
                        <!-- Custom CSS for strict PDF styling with Dynamic Values -->
                        <style t-attf-type="text/css">
                            .table-custom-bordered {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                border-collapse: collapse !important;
                                width: 100%;
                            }
                            .table-custom-bordered th,
                            .table-custom-bordered td {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                padding: 2px 4px !important;
                                vertical-align: middle;
                            }
                            .table-custom-bordered thead th {
                                border-bottom: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                font-weight: bold;
                                background-color: <t t-esc="header_bg"/> !important;
                                color: <t t-esc="header_text"/> !important;
                                text-transform: uppercase;
                                font-size: 0.9em;
                            }
                            /* Main Header Table Styles */
                            .table-header-grid {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                border-collapse: collapse !important;
                                width: 100%;
                            }
                            .table-header-grid td {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                            }

                            /* Utility helpers */
                            .text-bold { font-weight: bold; }
                        </style>

                        <!-- Title Section -->
                        <div class="row mb-1 text-center">
                            <div class="col-12">
                                <h5 style="font-weight: bold; margin: 0; text-transform: uppercase;">
                                    <span>Material Out</span>
                                </h5>
                            </div>
                        </div>

                        <!-- Main Invoice Table Container (Header Details) -->
                        <div class="row mt-2">
                            <div class="col-12">
                                <table class="table-header-grid">
                                    <tbody>
                                        <tr>
                                            <!-- LEFT SIDE: Address Stack -->
                                            <td style="width: 50%; vertical-align: center; padding: 5px;">

                                                <!-- 1. Seller (Company) Details -->
                                                <div t-if="o.company_id.invoice_layout_boxed" class="mb-3">
                                                    <strong style="font-size: 1.2em;"><span t-field="o.company_id.name"/></strong><br/>
                                                    <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                                    <div t-if="o.company_id.vat"><strong>GSTIN:</strong> <span t-field="o.company_id.vat"/></div>
                                                    <div t-if="o.company_id.email"><strong>Email:</strong> <span t-field="o.company_id.email"/></div>
                                                    <div t-if="o.company_id.partner_id.state_id">
                                                        <strong>State Name :</strong> <span t-field="o.company_id.partner_id.state_id.name"/>,
                                                        <strong>Code :</strong> <span t-field="o.company_id.partner_id.state_id.l10n_in_tin"/>
                                                    </div>
                                                </div>

                                                <t t-if="not o.company_id.invoice_layout_boxed">
                                                    <!-- Standard Odoo Header area would have covered this -->
                                                </t>

                                                <div t-if="o.partner_id" class="mb-3">
                                                    <strong>Dispatch To</strong><br/>
                                                    <strong style="font-size: 1.1em;"><span t-field="o.partner_id.name"/></strong><br/>
                                                    <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                                    <div t-if="o.partner_id.vat"><strong>GSTIN:</strong> <span t-field="o.partner_id.vat"/></div>
                                                    <div t-if="o.company_id.partner_id.state_id">
                                                        <strong>State Name :</strong> <span t-field="o.partner_id.state_id.name"/>,
                                                        <strong>Code :</strong> <span t-field="o.partner_id.state_id.l10n_in_tin"/>
                                                    </div>
                                                </div>

                                                <div>
                                                    <strong>Party</strong><br/>
                                                    <strong style="font-size: 1.1em;"><span t-field="o.partner_id.name"/></strong><br/>
                                                    <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                                    <div t-if="o.partner_id.vat"><strong>GSTIN:</strong> <span t-field="o.partner_id.vat"/></div>
                                                    <div t-if="o.company_id.partner_id.state_id">
                                                        <strong>State Name :</strong> <span t-field="o.partner_id.state_id.name"/>,
                                                        <strong>Code :</strong> <span t-field="o.partner_id.state_id.l10n_in_tin"/>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- RIGHT SIDE: Reference Details (Nested Table for Grid) -->
                                            <td style="width: 50%; padding: 0; vertical-align: top;">
                                                <table class="table table-sm table-borderless mb-0 h-100" style="margin: 0; width: 100%;">
                                                     <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td t-attf-style="border-right: {{border_width}}px solid {{border_color}}; width: 50%; padding: 5px;"><strong>Challan No:</strong> <br/><span t-field="o.name"/></td>
                                                        <td style="padding: 5px;"><strong>Date:</strong> <br/><span t-field="o.scheduled_date"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td t-attf-style="border-right: {{border_width}}px solid {{border_color}}; padding: 5px;"><strong>Delivery Note:</strong> <br/><span t-field="o.sale_id.delivery_note"/></td>
                                                        <td style="padding: 5px;"><strong>Mode/Terms of Payment:</strong> <br/><span t-field="o.sale_id.mode_of_payment"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td t-attf-style="border-right: {{border_width}}px solid {{border_color}}; padding: 5px;"><strong>Supplier Ref:</strong> <br/><span t-field="o.sale_id.supplier_reference"/></td>
                                                        <td style="padding: 5px;"><strong>Other Ref:</strong> <br/><span t-field="o.sale_id.other_reference"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td t-attf-style="border-right: {{border_width}}px solid {{border_color}}; padding: 5px;"><strong>Buyer Order No:</strong> <br/><span t-field="o.sale_id.buyers_order_no"/></td>
                                                        <td style="padding: 5px;"><strong>Dated:</strong> <br/><span t-field="o.sale_id.buyers_order_date"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td t-attf-style="border-right: {{border_width}}px solid {{border_color}}; padding: 5px;"><strong>Dispatch Doc No:</strong> <br/><span t-field="o.sale_id.dispatch_doc_no"/></td>
                                                        <td style="padding: 5px;"><strong>Del. Note Date:</strong> <br/><span t-field="o.sale_id.delivery_note_date"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td t-attf-style="border-right: {{border_width}}px solid {{border_color}}; padding: 5px;"><strong>Dispatched Through:</strong> <br/><span t-field="o.sale_id.dispatch_through"/></td>
                                                        <td style="padding: 5px;"><strong>Destination:</strong> <br/><span t-field="o.sale_id.destination"/></td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="2" style="padding: 5px;"><strong>Terms of Delivery:</strong> <br/><span t-field="o.sale_id.terms_of_delivery"/></td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Invoice Lines Table -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <table class="table-custom-bordered">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 5%;">SN</th>
                                            <th class="text-start">Description of Goods</th>
                                            <th class="text-center" style="width: 10%;">Part No.</th>
                                            <th class="text-end" style="width: 10%;">Quantity</th>
                                            <th class="text-end" style="width: 10%;">Rate</th>
                                            <th class="text-end" style="width: 5%;">Per</th>
                                            <th class="text-end" style="width: 15%;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="idx" t-value="1"/>
                                        <t t-foreach="o.move_ids_without_package" t-as="line">
                                            <td class="text-center"><span t-esc="idx"/></td>
                                            <td><span t-esc="line.product_id.name + (' - ' + line.product_id.product_tmpl_id.description_sale if line.product_id.product_tmpl_id.description_sale else '')"/></td>
                                            <td class="text-center"><span t-field="line.product_id.default_code"/></td>
                                            <td class="text-end"><span t-field="line.quantity"/> <span t-field="line.product_uom.name"/></td>
                                            <td class="text-end"><span t-field="line.price_unit"/></td>
                                            <td class="text-end"><span t-field="line.product_uom"/></td>
                                            <td class="text-end"><span t-field="line.product_uom"/></td>
                                            <t t-set="idx" t-value="idx + 1"/>
                                        </t>
                                        <!-- Totals -->
                                        <t t-set="total_qty" t-value="sum(line.quantity for line in o.move_ids_without_package)"/>
                                        <t t-set="product_lines" t-value="o.move_ids_without_package"/>
                                        <t t-set="total_uom" t-value="product_lines[0].product_uom.name if product_lines else ''"/>
                                        <tr>
                                            <td colspan="4" class="text-end text-bold">Total</td>

                                            <td class="text-end text-bold">
                                                <span t-esc="total_qty"/> <span t-esc="total_uom"/>
                                            </td>

                                            <td class="text-end"></td>
                                            <td class="text-end"></td>

                                            <td class="text-end text-bold">
<!--                                                <span t-field="o.amount_untaxed"/>-->
                                            </td>
                                        </tr>

                                        <!-- Tax Totals Loop -->
<!--                                        <t t-foreach="o.tax_totals['subtotals']" t-as="subtotal">-->
<!--                                            <t t-foreach="subtotal['tax_groups']" t-as="tax_group">-->
<!--                                                <tr>-->
<!--                                                    <td colspan="7" class="text-end"><span t-esc="tax_group['group_name']"/></td>-->
<!--                                                    <td class="text-end"><span t-esc="tax_group['tax_amount_currency']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>-->
<!--                                                </tr>-->
<!--                                            </t>-->
<!--                                        </t>-->

<!--                                        &lt;!&ndash; Grand Total &ndash;&gt;-->
<!--                                        <tr>-->
<!--                                            <td colspan="7" class="text-end text-bold">Grand Total</td>-->
<!--                                            <td class="text-end text-bold"><span t-field="o.amount_total"/></td>-->
<!--                                        </tr>-->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                         <!-- Amount in Words -->
