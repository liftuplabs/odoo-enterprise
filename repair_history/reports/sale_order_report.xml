<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_custom_sale_order" inherit_id="sale.report_saleorder_document">

             <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.basic_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=lang)" />

                    <t t-set="border_color" t-value="doc.company_id.custom_invoice_border_color or '#000000'"/>
                    <t t-set="border_width" t-value="doc.company_id.custom_invoice_border_thickness or 1"/>
                    <t t-set="header_bg" t-value="doc.company_id.custom_invoice_header_bg_color or '#f0f0f0'"/>
                    <t t-set="header_text" t-value="doc.company_id.custom_invoice_header_text_color or '#000000'"/>
                    <t t-set="font_family" t-value="doc.company_id.custom_invoice_font_family or 'Arial'"/>
                    <t t-set="page_title" t-value="'QUOTATION'"/>

                    <t t-set="product_lines" t-value="doc.order_line"/>
                    <t t-set="line_count" t-value="len(product_lines)"/>

                    <t t-set="shrink_class" t-value="''"/>
                    <t t-set="base_font_size" t-value="'12px'"/>
                    <t t-set="qr_max_height" t-value="'120px'"/>
                    <t t-set="spacing_modifier" t-value="'1.1'"/>

                    <t t-if="line_count &gt; 10 and line_count &lt;= 20">
                        <t t-set="shrink_class" t-value="'layout-compact'"/>
                        <t t-set="base_font_size" t-value="'11px'"/>
                        <t t-set="qr_max_height" t-value="'100px'"/>
                        <t t-set="spacing_modifier" t-value="'1.0'"/>
                    </t>

                    <t t-if="line_count &gt; 20">
                        <t t-set="shrink_class" t-value="'layout-dense-30'"/>
                        <t t-set="base_font_size" t-value="'10px'"/>
                        <t t-set="qr_max_height" t-value="'80px'"/>
                        <t t-set="spacing_modifier" t-value="'0.95'"/>
                    </t>

                    <div t-attf-class="page #{shrink_class}" t-attf-style="font-family: {{font_family}}, sans-serif; font-size: {{base_font_size}}; line-height: {{spacing_modifier}}; padding-top: 0px; margin-top: 0px;">

                        <style t-attf-type="text/css">
                            /* Force strict pagination so the document breaks instead of shrinking */
                            table {
                                page-break-inside: auto !important;
                            }
                            tr {
                                page-break-inside: avoid !important;
                                page-break-after: auto !important;
                            }
                            thead {
                                display: table-header-group !important;
                            }
                            tbody {
                                display: table-row-group !important;
                            }

                            .table-custom-bordered {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                border-collapse: collapse !important;
                                width: 100%;
                            }
                            .table-custom-bordered th,
                            .table-custom-bordered td {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                padding: 2px 4px !important;
                                vertical-align: middle;
                            }
                            .table-custom-bordered thead th {
                                border-bottom: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                font-weight: bold;
                                background-color: <t t-esc="header_bg"/> !important;
                                color: <t t-esc="header_text"/> !important;
                                text-transform: uppercase;
                                font-size: 0.9em;
                            }

                            /* Main Header Table Grid Base Styling */
                            .table-header-grid {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                border-collapse: collapse !important;
                                width: 100%;
                                table-layout: fixed;
                                page-break-inside: avoid !important;
                            }
                            .table-header-grid > tbody > tr > td {
                                border: <t t-esc="border_width"/>px solid <t t-esc="border_color"/> !important;
                                vertical-align: top;
                            }

                            /* Specific padding control to prevent text from touching lines */
                            .address-box { padding: 6px 8px !important; }
                            .meta-cell { padding: 5px 6px !important; vertical-align: top !important; }
                            .text-bold { font-weight: bold; }

                            /* Compact Layout Adjustments */
                            .layout-compact .table-custom-bordered th,
                            .layout-compact .table-custom-bordered td {
                                padding: 1px 3px !important;
                            }
                            .layout-compact .address-box { padding: 4px 6px !important; }
                            .layout-compact .meta-cell { padding: 4px 5px !important; }
                            .layout-compact .mt-2, .layout-compact .mt-3, .layout-compact .mt-5 { margin-top: 4px !important; }
                            .layout-compact .mb-2, .layout-compact .mb-3 { margin-bottom: 4px !important; }

                            /* High Density 30-Line Layout Adjustments (Locked to allow overflow) */
                            .layout-dense-30 .table-custom-bordered th,
                            .layout-dense-30 .table-custom-bordered td {
                                padding: 2px !important;
                            }
                            .layout-dense-30 .address-box { padding: 4px 5px !important; }
                            .layout-dense-30 .meta-cell { padding: 3px 5px !important; }
                            .layout-dense-30 .mt-2, .layout-dense-30 .mt-3, .layout-dense-30 .mt-5 { margin-top: 2px !important; }
                            .layout-dense-30 .mb-1, .layout-dense-30 .mb-2, .layout-dense-30 .mb-3 { margin-bottom: 2px !important; }
                            .layout-dense-30 h5 { font-size: 1.1em !important; }
                        </style>

                        <div class="row mb-1 text-center">
                            <div class="col-12">
                                <h5 style="font-weight: bold; margin: 0; text-transform: uppercase;">
                                    <span t-esc="page_title"/>
                                </h5>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12">
                                <table class="table-header-grid">
                                    <tbody>
                                        <tr>
                                            <td style="width: 50%; vertical-align: top;" class="address-box">
                                                <div t-if="doc.company_id.invoice_layout_boxed" class="mb-3">
                                                    <strong style="font-size: 1.1em;"><span t-field="doc.company_id.name"/></strong><br/>
                                                    <span t-field="doc.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                                    <div t-if="doc.company_id.vat"><strong>GSTIN:</strong> <span t-field="doc.company_id.vat"/></div>
                                                    <div t-if="doc.company_id.email"><strong>Email:</strong> <span t-field="doc.company_id.email"/></div>
                                                    <div t-if="doc.company_id.partner_id.state_id">
                                                        <strong>State Name :</strong> <span t-field="doc.company_id.partner_id.state_id.name"/>,
                                                        <strong>Code :</strong> <span t-field="doc.company_id.partner_id.state_id.l10n_in_tin"/>
                                                    </div>
                                                </div>

                                                <div t-if="doc.partner_shipping_id and (doc.partner_shipping_id != doc.partner_id)" class="mb-3">
                                                    <strong>Consignee (Ship To):</strong><br/>
                                                    <strong style="font-size: 1.1em;"><span t-field="doc.partner_id.name"/></strong><br/>
                                                    <span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                                    <div t-if="doc.partner_shipping_id.vat"><strong>GSTIN:</strong> <span t-field="doc.partner_shipping_id.vat"/></div>
                                                    <div t-if="doc.company_id.partner_id.state_id">
                                                        <strong>State Name :</strong> <span t-field="doc.partner_id.state_id.name"/>,
                                                        <strong>Code :</strong> <span t-field="doc.partner_id.state_id.l10n_in_tin"/>
                                                    </div>
                                                </div>

                                                <div>
                                                    <strong>Bill To (Buyer):</strong><br/>
                                                    <strong style="font-size: 1.1em;"><span t-field="doc.partner_id.name"/></strong><br/>
                                                    <span t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                                    <div t-if="doc.partner_id.vat"><strong>GSTIN:</strong> <span t-field="doc.partner_id.vat"/></div>
                                                    <div t-if="doc.company_id.partner_id.state_id">
                                                        <strong>State Name :</strong> <span t-field="doc.partner_id.state_id.name"/>,
                                                        <strong>Code :</strong> <span t-field="doc.partner_id.state_id.l10n_in_tin"/>
                                                    </div>
                                                </div>
                                            </td>

                                            <td style="width: 50%; padding: 0 !important; vertical-align: top;">
                                                <table style="margin: 0; width: 100%; border-collapse: collapse; height: 100%; table-layout: fixed;">
                                                     <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td class="meta-cell" t-attf-style="border-right: {{border_width}}px solid {{border_color}}; width: 50%;">
                                                            <t t-if="doc.name">
                                                                <strong>Quotation No.</strong>
                                                            </t>
<!--                                                            <t t-else="">-->
<!--                                                                <strong>Invoice No:</strong>-->
<!--                                                            </t>-->
                                                            <br/><span t-field="doc.name"/>
                                                        </td>
                                                        <td class="meta-cell" style="width: 50%;"><strong>Date:</strong><br/><span t-field="doc.date_order"/></td>
                                                    </tr>

<!--                                                    <t t-if="doc.move_type in ['out_refund', 'in_refund']">-->
<!--                                                        <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">-->
<!--                                                            <td class="meta-cell" t-attf-style="border-right: {{border_width}}px solid {{border_color}};">-->
<!--                                                                <strong>Invoice No:</strong><br/>-->
<!--                                                                <span t-esc="doc.reversed_entry_id.name or doc.ref"/>-->
<!--                                                            </td>-->
<!--                                                            <td class="meta-cell">-->
<!--                                                                <strong>Inv. Date:</strong><br/>-->
<!--                                                                <span t-esc="doc.reversed_entry_id.invoice_date"/>-->
<!--                                                            </td>-->
<!--                                                        </tr>-->
<!--                                                    </t>-->
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td class="meta-cell" t-attf-style="border-right: {{border_width}}px solid {{border_color}};"><strong>Delivery Note:</strong><br/><span t-field="doc.delivery_note"/></td>
                                                        <td class="meta-cell"><strong>Pay Mode:</strong><br/><span t-field="doc.mode_of_payment"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td class="meta-cell" t-attf-style="border-right: {{border_width}}px solid {{border_color}};"><strong>Supplier Ref:</strong><br/><span t-field="doc.supplier_reference"/></td>
                                                        <td class="meta-cell"><strong>Other Ref:</strong><br/><span t-field="doc.other_reference"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td class="meta-cell" t-attf-style="border-right: {{border_width}}px solid {{border_color}};"><strong>Buyer Order No:</strong><br/><span t-field="doc.buyers_order_no"/></td>
                                                        <td class="meta-cell"><strong>Dated:</strong><br/><span t-field="doc.buyers_order_date"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td class="meta-cell" t-attf-style="border-right: {{border_width}}px solid {{border_color}};"><strong>Dispatch Doc No:</strong><br/><span t-field="doc.dispatch_doc_no"/></td>
                                                        <td class="meta-cell"><strong>Del. Note Date:</strong><br/><span t-field="doc.delivery_note_date"/></td>
                                                    </tr>
                                                    <tr t-attf-style="border-bottom: {{border_width}}px solid {{border_color}};">
                                                        <td class="meta-cell" t-attf-style="border-right: {{border_width}}px solid {{border_color}};"><strong>Dispatched Through:</strong><br/><span t-field="doc.dispatch_through"/></td>
                                                        <td class="meta-cell"><strong>Destination:</strong><br/><span t-field="doc.destination"/></td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="2" class="meta-cell"><strong>Nature of Processig:</strong><br/><span t-field="doc.nature_of_process"/></td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <table class="table-custom-bordered">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 4%;">SN</th>
                                            <th class="text-start" style="width: 46%;">Description of Goods</th>
                                            <th class="text-center" style="width: 8%;">HSN/SAC</th>
                                            <th class="text-center" style="width: 10%;">Part No.</th>
                                            <th class="text-end" style="width: 8%;">Quantity</th>
                                            <th class="text-end" style="width: 10%;">Rate</th>
                                            <th class="text-end" style="width: 4%;">Per</th>
                                            <th class="text-end" style="width: 10%;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="idx" t-value="1"/>
                                        <t t-foreach="doc.order_line" t-as="line">
                                            <tr t-if="line.display_type == 'product'">
                                                <td class="text-center" style="width: 4%;"><span t-esc="idx"/></td>
                                                <td class="text-start" style="width: 46%;"><span t-esc="line.product_template_id.name + (' - ' + line.product_template_id.description_sale if line.product_template_id.description_sale else '')"/></td>
                                                <td class="text-center" style="width: 8%;"><span t-field="line.l10n_in_hsn_code"/></td>
                                                <td class="text-center" style="width: 10%;"><span t-field="line.product_template_id.default_code"/></td>
                                                <td class="text-end" style="width: 8%; white-space: nowrap;"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom.name"/></td>
                                                <td class="text-end" style="width: 10%;"><span t-field="line.price_unit"/></td>
                                                <td class="text-end" style="width: 4%;"><span t-field="line.product_uom"/></td>
                                                <td class="text-end" style="width: 10%;"><span t-field="line.price_subtotal"/></td>
                                                <t t-set="idx" t-value="idx + 1"/>
                                            </tr>
                                        </t>
                                        <t t-set="total_qty" t-value="sum(line.product_uom_qty for line in doc.order_line)"/>
                                        <t t-set="total_uom" t-value="product_lines[0].produc t_uom.name if product_lines else ''"/>
                                        <tr>
                                            <td colspan="4" class="text-end text-bold">Total</td>
                                            <td class="text-end text-bold" style="white-space: nowrap;">
                                                <span t-esc="total_qty"/> <span t-esc="total_uom"/>
                                            </td>
                                            <td class="text-end"></td>
                                            <td class="text-end"></td>
                                            <td class="text-end text-bold"><span t-field="doc.amount_untaxed"/></td>
                                        </tr>

                                        <t t-foreach="doc.tax_totals['subtotals']" t-as="subtotal">
                                            <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                                <tr>
                                                    <td colspan="7" class="text-end"><span t-esc="tax_group['group_name']"/></td>
                                                    <td class="text-end"><span t-esc="tax_group['tax_amount_currency']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                </tr>
                                            </t>
                                        </t>

                                        <tr>
                                            <td colspan="7" class="text-end text-bold">Grand Total</td>
                                            <td class="text-end text-bold"><span t-field="doc.amount_total"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

<!--                         <div class="row mt-2" style="page-break-inside: avoid;">-->
<!--                            <div class="col-12">-->
<!--                                <strong>Amount Chargeable (in words):  E. &amp; doc.E</strong> <br/>-->
<!--                                <span t-field="doc.amount_total_words"/>-->
<!--                            </div>-->
<!--                        </div>-->

                        <div class="row mt-3" style="page-break-inside: auto;">
                             <t t-set="hsn_summary" t-value="doc._l10n_in_get_hsn_summary_table()"/>
                             <t t-if="hsn_summary">
                                <div class="col-12">
                                    <strong class="mb-1 d-block">HSN/SAC Summary:</strong>
                                    <table class="table-custom-bordered">
                                        <thead>
                                            <tr>
                                                <th rowspan="2" class="text-center" style="vertical-align: middle;">HSN/SAC</th>
                                                <th rowspan="2" class="text-end" style="vertical-align: middle;">Taxable Value</th>
                                                <t t-if="hsn_summary['has_gst']">
                                                    <th class="text-center" colspan="2">CGST</th>
                                                    <th class="text-center" colspan="2">SGST</th>
                                                </t>
                                                <t t-if="hsn_summary['has_igst']">
                                                    <th class="text-center" colspan="2">IGST</th>
                                                </t>
                                                <th rowspan="2" class="text-end" style="vertical-align: middle;">Total Tax Amount</th>
                                            </tr>
                                             <tr>
                                                <t t-if="hsn_summary['has_gst']">
                                                    <th class="text-end">Rate</th>
                                                    <th class="text-end">Amount</th>
                                                    <th class="text-end">Rate</th>
                                                    <th class="text-end">Amount</th>
                                                </t>
                                                <t t-if="hsn_summary['has_igst']">
                                                     <th class="text-end">Rate</th>
                                                     <th class="text-end">Amount</th>
                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="hsn_summary['items']" t-as="item">
                                                <td class="text-center"><span t-esc="item['l10n_in_hsn_code']"/></td>
                                                <td class="text-end"><span t-esc="item['amount_untaxed']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                <t t-if="hsn_summary['has_gst']">
                                                    <td class="text-end"><span t-esc="item['rate'] / 2"/>%</td>
                                                    <td class="text-end"><span t-esc="item['tax_amount_cgst']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                    <td class="text-end"><span t-esc="item['rate'] / 2"/>%</td>
                                                    <td class="text-end"><span t-esc="item['tax_amount_sgst']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                </t>
                                                <t t-if="hsn_summary['has_igst']">
                                                    <td class="text-end"><span t-esc="item['rate']"/>%</td>
                                                    <td class="text-end"><span t-esc="item['tax_amount_igst']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                </t>
                                                <td class="text-end">
                                                    <t t-set="total_tax_amount" t-value="item.get('tax_amount_igst', 0.0) + item.get('tax_amount_cgst', 0.0) + item.get('tax_amount_sgst', 0.0) + item.get('tax_amount_cess', 0.0)"/>
                                                    <span t-esc="total_tax_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                </td>
                                            </tr>
                                            <tr class="text-bold">
                                                <td class="text-end">Total:</td>
                                                <td class="text-end"><span t-esc="sum(item['amount_untaxed'] for item in hsn_summary['items'])" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                 <t t-if="hsn_summary['has_gst']">
                                                    <td></td>
                                                    <td class="text-end"><span t-esc="sum(item['tax_amount_cgst'] for item in hsn_summary['items'])" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                    <td></td>
                                                    <td class="text-end"><span t-esc="sum(item['tax_amount_sgst'] for item in hsn_summary['items'])" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                </t>
                                                 <t t-if="hsn_summary['has_igst']">
                                                    <td></td>
                                                    <td class="text-end"><span t-esc="sum(item['tax_amount_igst'] for item in hsn_summary['items'])" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                                </t>
                                                <td class="text-end">
                                                     <t t-set="grand_total_tax_amount" t-value="sum(item.get('tax_amount_igst', 0.0) + item.get('tax_amount_cgst', 0.0) + item.get('tax_amount_sgst', 0.0) + item.get('tax_amount_cess', 0.0) for item in hsn_summary['items'])"/>
                                                    <span t-esc="grand_total_tax_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                             </t>
                        </div>

                         <div class="row mt-2">
                             <div class="col-12 text-end">
                                 Tax Amount (in words): <span t-esc="doc.currency_id.amount_to_text(doc.amount_tax)"/>
                             </div>
                         </div>

                        <div class="row mt-5" style="page-break-inside: avoid;">
                            <div class="col-6">
                                <strong>Company's PAN: </strong>
                                <span t-field="doc.company_id.l10n_in_pan"/><br/><br/>
                                <strong>Declaration:</strong><br/>
                                <span>We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.</span>
                            </div>
                            <div class="col-6 text-end">
                                <t t-set="bank_info" t-value="doc.company_id.partner_id.bank_ids[:1]"/>
                                <t t-if="doc.company_id.show_bank_detail">
                                    <div t-if="bank_info" style="display: inline-block; text-align: left; min-width: 200px;">
                                        <strong>Company's Bank Details</strong><br/>
                                        <div class="row m-0">
                                            <div class="p-0" style="width: 100px;"><strong>Bank Name</strong></div>
                                            <div class="p-0" style="width: 10px;">:</div>
                                            <div class="p-0 col"><span t-field="bank_info.bank_id.name"/></div>
                                        </div>
                                        <div class="row m-0">
                                            <div class="p-0" style="width: 100px;"><strong>A/C No.</strong></div>
                                            <div class="p-0" style="width: 10px;">:</div>
                                            <div class="p-0 col"><span t-field="bank_info.acc_number"/></div>
                                        </div>
                                        <div class="row m-0">
                                            <div class="p-0" style="width: 100px;"><strong>Branch &amp; IFSC</strong></div>
                                            <div class="p-0" style="width: 10px;">:</div>
                                            <div class="p-0 col">
                                                <span t-if="bank_info.bank_id.city" t-field="bank_info.bank_id.city"/>
                                                <t t-if="bank_info.bank_id.city and bank_info.bank_id.bic"> - </t>
                                                <span t-field="bank_info.bank_id.bic"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="row mt-5" style="page-break-inside: avoid;">
                            <div class="col-6">
                                <strong>Customer's Seal and Signature</strong><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>For <span t-field="doc.company_id.name"/></strong>
                                <br/><br/>
                                <t t-if="doc.company_id.digital_signature">
