<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone List View for Repair Internal Notes -->
    <record id="view_repair_internal_note_tree" model="ir.ui.view">
        <field name="name">repair.internal.note.list</field>
        <field name="model">repair.internal.note</field>
        <field name="arch" type="xml">
            <list string="Internal Notes" default_order="date desc" create="1" edit="1" delete="1">
                <field name="date" string="Date &amp; Time" width="160px"/>
                <field name="user_id" string="Created By" widget="many2one_avatar_user" width="180px"/>
                <field name="note" string="Internal Note"/>
                <field name="attachment_ids" widget="many2many_binary" string="Attachments"/>
            </list>
        </field>
    </record>

    <!-- Standalone Form View for Repair Internal Notes (for popups / editing) -->
    <record id="view_repair_internal_note_form" model="ir.ui.view">
        <field name="name">repair.internal.note.form</field>
        <field name="model">repair.internal.note</field>
        <field name="arch" type="xml">
            <form string="Internal Note">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="1" options="{'no_open': True}"/>
                            <field name="date" readonly="1"/>
                        </group>
                        <group>
                            <field name="attachment_ids" widget="many2many_binary" string="Attachments"/>
                        </group>
                    </group>
                    <separator string="Note Details"/>
                    <field name="note" placeholder="Enter detailed internal notes, observations, or technical details here..." options="{'collaborative': false}"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inherit Repair Order Form View to add "Internal Note" Tab -->
    <record id="view_repair_order_form_inherit_internal_notes" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.internal.notes</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='repair_notes']" position="after">
                <page string="Internal Note" name="internal_notes_tab" groups="base.group_user">
                    <!-- Compose Box for quickly adding a new internal note -->
                    <div class="card mb-3 p-3 bg-light border-0">
                        <div class="mb-2">
                            <span class="fw-bold text-primary">
                                <i class="fa fa-pencil me-1"/> Record New Internal Note
                            </span>
                        </div>
                        <field name="new_internal_note"
                               placeholder="Type detailed repair notes, observations, diagnostic findings, or technical details here..."
                               options="{'collaborative': false}"/>
                        <div class="mt-2 row align-items-center">
                            <div class="col-md-9">
                                <field name="new_internal_note_attachment_ids"
                                       widget="many2many_binary"
                                       string="Upload Attachments"/>
                            </div>
                            <div class="col-md-3 text-end">
                                <button name="action_add_internal_note"
                                        string="Save Note"
                                        type="object"
                                        class="btn btn-primary"
                                        icon="fa-save"/>
                            </div>
                        </div>
                    </div>

                    <!-- History Log of Previous Internal Notes -->
                    <separator string="Internal Notes History" class="mt-3 mb-2"/>
                    <field name="internal_note_ids" nolabel="1">
                        <list decoration-muted="create_date == False" default_order="date desc">
                            <field name="date" string="Date &amp; Time" width="160px"/>
                            <field name="user_id" string="Created By" widget="many2one_avatar_user" width="180px"/>
                            <field name="note" string="Note Details"/>
                            <field name="attachment_ids" widget="many2many_binary" string="Attachments"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
