<odoo>
    <data>
        <record id="view_order_line_repair" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <!-- <xpath expr="//button[@name='action_draft']" position="after">
                    <button name="action_create_repair" type="object" string="Create Repair"/>
                </xpath> -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_alternate_sos"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-usd"
                            invisible="alternate_so_count == 0">
                        <field name="alternate_so_count" widget="statinfo" string="Customer POs"/>
                    </button>
                </xpath>

                <!-- Link Original Order Field -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="original_order_id"
                           domain="[('partner_id', '=', partner_id)]"
                           options="{'no_create': True}"/>
                </xpath>

                <!-- Add Buttons to the Header -->
                <xpath expr="//header" position="inside">
                    <!-- Create the Alternate SO -->
                    <button name="action_create_customer_so"
                            string="Create Customer PO"
                            type="object"
                            class="btn-primary"
                            invisible="alternate_so_count or original_order_id or state not in ['draft', 'sent']"/>

                    <!-- Compare and generate differences -->
                    <button name="action_compare_and_set_pending"
                            string="Compare &amp; Generate Pending Products"
                            type="object"
                            class="btn-secondary"
                            invisible="not original_order_id"/>
                </xpath>

                <!-- Pending Products Tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Pending Customer Products" name="pending_products" invisible="not pending_product_ids">
                        <field name="pending_product_ids" readonly="1">
                            <list string="Pending Products" editable="bottom">
                                <field name="original_order_id"/>
                                <field name="product_id"/>
                                <field name="product_uom_qty"/>
                                <field name="price_unit"/>
                                <button name="action_add_to_so"
                                        string="Add to Sale Order"
                                        type="object"
                                        icon="fa-plus-circle"
                                        class="btn btn-link"
                                        context="{'parent_sale_order_id': parent.id}"/>
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//button[@id='action_confirm']" position="attributes">
                    <attribute name="invisible">state != 'sent' or alternate_so_count &gt; 0</attribute>
                </xpath>

                <!-- 3. Target the second Confirm button (which has no ID) by matching its name attribute -->
                <xpath expr="//header/button[@name='action_confirm' and not(@id)]" position="attributes">
                    <attribute name="invisible">state != 'draft' or alternate_so_count &gt; 0</attribute>
                </xpath>
                <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">state not in ['draft', 'sent', 'sale'] or not id or locked or alternate_so_count &gt; 0</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                    <field name="is_repair_parts" column_invisible="1"/>
                    <field name="lot_ids" widget="many2many_tags" optional="hide"/>
                    <field name="repair_id" column_invisible="1"/>
                </xpath>
    <!--            <xpath expr="//field[@name='payment_term_id']" position="after">-->
    <!--                <field name="purchase_order_ids" widget="many2many_tags" invisible="repair_count == 0" />-->
    <!--            </xpath>-->
                <xpath expr="//page[@name='other_information']" position="after">
                     <page string="Transport &amp; Delivery" name="custom_transport_info">
                        <group>
                            <group string="Delivery Details">
                                <field name="dispatch_doc_no"/>
                                <field name="dispatch_through"/>
                                <field name="destination"/>
                                <field name="delivery_note"/>
                                <field name="delivery_note_date"/>
                            </group>
                            <group string="References">
                                <field name="supplier_reference"/>
                                <field name="other_reference"/>
                                <field name="buyers_order_no"/>
                                <field name="buyers_order_date"/>
                                 <field name="mode_of_payment"/>
                            </group>
                        </group>
                        <group string="Terms">
                             <field name="terms_of_delivery"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>