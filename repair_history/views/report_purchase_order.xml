<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_hsn_inherit" inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//div[@class='page']" position="before">
            <style>
                .table-custom-bordered {
                    width: 100% !important;
                    border: 1px solid black !important;
                    border-collapse: collapse !important;
                    margin-bottom: 20px !important;
                    margin-top: 20px !important;
                    table-layout: fixed; /* Ensures column widths are respected */
                }
                .table-custom-bordered th, .table-custom-bordered td {
                    border: 1px solid black !important;
                    padding: 4px 6px !important;
                    vertical-align: top;
                    word-wrap: break-word;
                }
                /* Bold and Centered Headers */
                .table-custom-bordered thead th {
                    background-color: #f8f9fa;
                    font-weight: bold !important;
                    text-align: center !important;
                    text-transform: uppercase;
                    vertical-align: middle !important;
                }
                .text-bold { font-weight: bold; }
                /* Hide top right address from standard layout */
                .header div[name="company_address"], .header .col-6.text-end { display: none !important; }
            </style>
            <style>
                .table-custom-bordered {
                    width: 100% !important;
                    border: 1px solid black !important;
                    border-collapse: collapse !important;
                    margin-bottom: 20px !important;
                    margin-top: 20px !important;
                    table-layout: fixed;
                }
                .table-custom-bordered th, .table-custom-bordered td {
                    border: 1px solid black !important;
                    padding: 4px 6px !important;
                    vertical-align: top;
                    word-wrap: break-word;
                    font-size: 14px !important; /* Forces uniform font size */
                }
            </style>
        </xpath>

        <xpath expr="//t[@t-set='address']" position="replace"><t t-set="address"/></xpath>
        <xpath expr="//t[@t-set='information_block']" position="replace"><t t-set="information_block"/></xpath>
        <xpath expr="//div[@id='informations']" position="replace"/>
        <xpath expr="//div[@class='page']/div[@class='oe_structure'][1]" position="after">
            <table class="table-header-grid">
                <tbody>
                    <tr>
                        <td style="width: 50%; vertical-align: top; padding: 10px;">
                            <div class="mb-3">
                                <strong style="font-size: 1.2em;"><span t-field="o.company_id.name"/></strong><br/>
                                <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                <div t-if="o.company_id.vat"><strong>GSTIN:</strong> <span t-field="o.company_id.vat"/></div>
                                <div t-if="o.company_id.email"><strong>Email:</strong> <span t-field="o.company_id.email"/></div>
                            </div>

                            <div t-if="o.dest_address_id" class="mb-3">
                                <strong>Consignee (Ship To):</strong><br/>
                                <strong style="font-size: 1.1em;"><span t-field="o.dest_address_id.name"/></strong><br/>
                                <span t-field="o.dest_address_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                <div t-if="o.dest_address_id.vat"><strong>GSTIN:</strong> <span t-field="o.dest_address_id.vat"/></div>
                            </div>

                            <div>
                                <strong>Vendor (Seller):</strong><br/>
                                <strong style="font-size: 1.1em;"><span t-field="o.partner_id.name"/></strong><br/>
                                <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                                <div t-if="o.partner_id.vat"><strong>GSTIN:</strong> <span t-field="o.partner_id.vat"/></div>
                            </div>
                        </td>

                        <td style="width: 50%;">
                            <table class="table table-sm table-borderless mb-0 h-100" style="width: 100%;">
                                <tr style="border-bottom: 1px solid black;">
                                    <td t-attf-style="border-right: 1px solid black; width: 50%; padding: 5px;">
                                        <strong>
                                            <t t-if="o.state in ['draft', 'sent', 'to approve']">RFQ No:</t>
                                            <t t-else="">Purchase Order No:</t>
                                        </strong>
                                        <br/>
                                        <span t-field="o.name"/>
                                    </td>
                                    <td style="padding: 5px;"><strong>Date:</strong> <br/><span t-field="o.date_order" t-options='{"widget": "date"}'/></td>
                                </tr>
                                <tr style="border-bottom: 1px solid black;">
                                    <td style="border-right: 1px solid black; padding: 5px;"><strong>Delivery Note:</strong> <br/><span t-field="o.delivery_note"/></td>
                                    <td style="padding: 5px;"><strong>Pay Mode:</strong> <br/><span t-field="o.payment_term_id"/></td>
                                </tr>
                                <tr style="border-bottom: 1px solid black;">
                                    <td style="border-right: 1px solid black; padding: 5px;"><strong>Supplier Ref:</strong> <br/><span t-field="o.partner_ref"/></td>
                                    <td style="padding: 5px;"><strong>Other Ref:</strong> <br/><span t-field="o.other_reference"/></td>
                                </tr>
                                <tr style="border-bottom: 1px solid black;">
                                    <td style="border-right: 1px solid black; padding: 5px;"><strong>Buyer Order No:</strong> <br/><span t-field="o.buyers_order_no"/></td>
                                    <td style="padding: 5px;"><strong>Dated:</strong> <br/><span t-field="o.buyers_order_date"/></td>
                                </tr>
                                <tr style="border-bottom: 1px solid black;">
                                    <td style="border-right: 1px solid black; padding: 5px;"><strong>Dispatch Doc No:</strong> <br/><span t-field="o.dispatch_doc_no"/></td>
                                    <td style="padding: 5px;"><strong>Del. Note Date:</strong> <br/><span t-field="o.delivery_note_date"/></td>
                                </tr>
                                <tr style="border-bottom: 1px solid black;">
                                    <td style="border-right: 1px solid black; padding: 5px;"><strong>Dispatched Through:</strong> <br/><span t-field="o.dispatch_through"/></td>
                                    <td style="padding: 5px;"><strong>Destination:</strong> <br/><span t-field="o.destination"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="padding: 5px;"><strong>Terms of Delivery:</strong> <br/><span t-field="o.notes"/></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>

        <xpath expr="//table[hasclass('o_main_table')]" position="replace">
            <table class="table-custom-bordered">
                <thead>
                    <tr>
                        <th style="width: 5%;">SN</th>
                        <th style="width: 40%;">Description of Goods</th>
                        <th style="width: 15%;">HSN/SAC</th>
                        <th style="width: 12%;">Part No.</th>
                        <th style="width: 10%;">Qty</th>
                        <th style="width: 15%;">Rate</th>
                        <th style="width: 13%;">Taxes</th>
                        <th style="width: 15%;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="idx" t-value="1"/>
                    <t t-foreach="o.order_line" t-as="line">
                        <tr t-if="not line.display_type">
                            <td class="text-center"><span t-esc="idx"/></td>
                            <td><span t-field="line.name"/></td>
                            <td class="text-center"><span t-field="line.product_id.l10n_in_hsn_code"/></td>
                            <td class="text-center"><span t-field="line.product_id.default_code"/></td>
                            <td class="text-center"><span t-field="line.product_qty"/> <span t-field="line.product_uom.name"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-center">
                                <span t-out="', '.join(map(lambda x: (x.description or x.name), line.taxes_id))"/>
                            </td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            <t t-set="idx" t-value="idx + 1"/>
                        </tr>
                    </t>
                    <tr>
                        <td colspan="7" class="text-end text-bold">Total</td>
                        <td class="text-end text-bold"><span t-field="o.amount_untaxed"/></td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-end text-bold" style="background-color: #f8f9fa;">Grand Total</td>
                        <td class="text-center text-bold" style="background-color: #f8f9fa;"><span t-field="o.amount_total"/></td>
                    </tr>
                </tbody>
            </table>
        </xpath>
        <xpath expr="//div[@id='total']" position="replace">
            <div class="row mt-2" style="font-size: 15px;">
                <div class="col-12">
                    <strong>Amount Chargeable (in words):</strong> <br/>
                    <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                </div>
            </div>
            <div class="row mt-3">
                <t t-set="hsn_summary" t-value="o._l10n_in_get_hsn_summary_table()"/>
                <div t-if="hsn_summary" class="col-12">
                    <strong>HSN/SAC Summary:</strong>
                    <table class="table-custom-bordered">
                        <thead>
                            <tr>
                                <th rowspan="2">HSN/SAC</th>
                                <th rowspan="2">Taxable Value</th>
                                <t t-if="hsn_summary['has_gst']">
                                    <th colspan="2">CGST</th>
                                    <th colspan="2">SGST</th>
                                </t>
                                <th rowspan="2">Total Tax</th>
                            </tr>
                            <tr>
                                <t t-if="hsn_summary['has_gst']">
                                    <th>Rate</th><th>Amt</th><th>Rate</th><th>Amt</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="hsn_summary['items']" t-as="item">
                                <td class="text-center"><span t-esc="item['l10n_in_hsn_code']"/></td>
                                <td class="text-end"><span t-esc="item['amount_untaxed']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <t t-if="hsn_summary['has_gst']">
                                    <td class="text-center"><span t-esc="item['rate'] / 2"/>%</td>
                                    <td class="text-end"><span t-esc="item['tax_amount_cgst']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td class="text-center"><span t-esc="item['rate'] / 2"/>%</td>
                                    <td class="text-end"><span t-esc="item['tax_amount_sgst']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </t>
                                <td class="text-end">
                                    <span t-esc="item['tax_amount_cgst'] + item['tax_amount_sgst']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row mt-2" style="font-size: 15px;">
                <div class="col-12 text-end">
                    <strong>Total Tax (in words): </strong> <span t-esc="o.currency_id.amount_to_text(o.amount_tax)"/>
                </div>
            </div>
            <div class="row mt-5" style="font-size: 15px;">
                <div class="col-7">
                    <strong>Declaration:</strong><br/>
                    <p t-field="o.company_id.report_footer" style="font-size: 10px;"/>
                </div>
                <div class="col-5 text-end">
                    <strong>For <span t-field="o.company_id.name"/></strong>
                    <br/><br/><br/>
                    <strong>Authorized Signatory</strong>
                </div>
            </div>
        </xpath>
    </template>

    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="report_name">purchase.report_purchaseorder</field>
        <field name="report_file">purchase.report_purchaseorder</field>
        <field name="name">Request for Quotation</field>
    </record>
</odoo>