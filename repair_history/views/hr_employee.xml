<!-- views/hr_employee_document_views.xml -->
<odoo>
    <record id="view_hr_employee_document_tree" model="ir.ui.view">
        <field name="name">hr.employee.document.tree</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="file_name"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_document_form" model="ir.ui.view">
        <field name="name">hr.employee.document.form</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="employee_id" readonly="1"/>
                    <field name="document_file" filename="file_name"/>
                    <field name="file_name"/>
                </group>
            </form>
        </field>
    </record>


    <record id="employee_form_inherit_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="before">
                <field name="is_not_visible"/>
            </xpath>
            <xpath expr="//page[@name='personal_information']" position="after">
                <page string="Documents" invisible="is_not_visible">
                    <field name="employee_document_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="document_file"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

