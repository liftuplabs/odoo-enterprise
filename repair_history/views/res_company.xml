    <record id="view_serial_excel_import_wizard" model="ir.ui.view">
        <field name="name">serial.excel.import.wizard.form</field>
        <field name="model">serial.excel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Serial Excel">
                <group>
                    <field name="file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <button name="action_import_serials" type="object" string="Load Serials" class="btn-primary"/>
                </group>
                <group>
                    <field name="serial_ids" nolabel="1">
                        <list editable="top">
                            <field name="serial_number"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_show_related_deliveries" type="object" string="Show Related Deliveries"
                            class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_serial_excel_wizard" model="ir.actions.act_window">
        <field name="name">Import Serial Excel</field>
        <field name="res_model">serial.excel.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
