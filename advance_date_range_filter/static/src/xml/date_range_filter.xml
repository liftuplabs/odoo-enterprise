<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_main')]" position="inside">
            <t t-if="dateFilterState and dateFilterState.config and env.config and env.config.viewType === 'list'">
                <div class="o_date_range_filter dropdown me-2">
                    <button class="btn btn-secondary dropdown-toggle" type="button" t-on-click="toggleDateDropdown">
                        <i class="fa fa-calendar me-1"/> Date Range
                    </button>
                    <div class="dropdown-menu p-3" t-att-class="{'show': dateFilterState.isOpen}" style="width: 250px; left: auto; right: 0;">
                        <div class="mb-2">
                            <label class="small text-muted">From:</label>
                            <input type="date" class="form-control" t-model="dateFilterState.fromDate" t-on-click.stop=""/>
                        </div>
                        <div class="mb-2">
                            <label class="small text-muted">To:</label>
                            <input type="date" class="form-control" t-model="dateFilterState.toDate" t-on-click.stop=""/>
                        </div>
                        <button class="btn btn-primary w-100" t-on-click="applyCustomDateRange">Apply</button>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>