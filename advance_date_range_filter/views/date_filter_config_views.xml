<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_date_filter_config_list" model="ir.ui.view">
        <field name="name">date.filter.config.list</field>
        <field name="model">date.filter.config</field>
        <field name="arch" type="xml">
            <list string="Date Filters">
                <field name="model_id"/>
                <field name="date_field_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_date_filter_config_form" model="ir.ui.view">
        <field name="name">date.filter.config.form</field>
        <field name="model">date.filter.config</field>
        <field name="arch" type="xml">
            <form string="Date Filter Config">
                <sheet>
                    <group>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="date_field_id" options="{'no_create': True}"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_date_filter_config" model="ir.actions.act_window">
        <field name="name">Date Filters</field>
        <field name="res_model">date.filter.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>